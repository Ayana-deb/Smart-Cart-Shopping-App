<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#F59E0B</color>
    <color name="bg">#F5F6FA</color>
    <color name="black">#000000</color>
    <color name="danger">#DC2626</color>
    <color name="primary">#4F46E5</color>
    <color name="primary_dark">#3730A3</color>
    <color name="success">#16A34A</color>
    <color name="text">#111827</color>
    <color name="text2">#6B7280</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">SmartCart</string>
    <style name="Btn" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="BtnOutline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="BtnSmall" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>
    <style name="TextBody"><item name="android:textSize">14sp</item><item name="android:textColor">#374151</item></style>
    <style name="TextMuted"><item name="android:textSize">12sp</item><item name="android:textColor">@color/text2</item></style>
    <style name="TextSection"><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/primary</item></style>
    <style name="TextTitle"><item name="android:textSize">20sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item></style>
    <style name="Theme.SmartCart" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="materialButtonStyle">@style/Btn</item>
    </style>
</resources>